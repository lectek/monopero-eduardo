# Copie para .env (nunca commitado) e preencha antes de subir em produção.
# docker-compose.yml lê essas variáveis automaticamente de um .env na mesma pasta.

# Onde o rbp.db REAL da loja mora (a mesma pasta que o IMS usa) — sem isso,
# o container sobe apontando pro banco de amostra (dev-data/), sem risco.
SAAS_DB_HOST_PATH=/caminho/real/ims_files
SAAS_DB_FILE=rbp.db

# "docker" sozinho já funciona (site + checkout + entrega). Acrescente
# ",oauth2" só depois de preencher OAUTH_GOOGLE_CLIENT_ID/SECRET abaixo.
SPRING_PROFILES_ACTIVE=docker

# Qualquer string longa e aleatória — nunca reaproveitar a de outro projeto.
JWT_SECRET=

# Access token de produção do Mercado Pago (o mesmo que o IMS já usa em
# C:\ims_files\config.properties, ver docs/ECOSSISTEMA.md).
MP_ACCESS_TOKEN=

# Google Cloud Console → Google Auth Platform → Clientes (projeto "Mini
# Mercadinho Rota"). Redirect URI já cadastrado lá:
# https://mercadinhorota.duckdns.org/login/oauth2/code/google
# Sem essas duas variáveis, o site funciona normalmente, só sem o botão
# "Entrar com Google". Enquanto o app estiver em modo de teste no Google,
# só e-mails cadastrados como "usuário de teste" conseguem entrar.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Token do domínio em www.duckdns.org (canto superior da página, depois de
# logar) — mantém mercadinhorota.duckdns.org apontando pro IP público atual
# da loja. Sem isso, o serviço "duckdns" do compose só avisa e não faz nada
# (o site continua acessível só por IP:porta direto, sem domínio/HTTPS).
DUCKDNS_DOMAIN=mercadinhorota
DUCKDNS_TOKEN=
