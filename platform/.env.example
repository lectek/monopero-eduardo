# Copie para .env (nunca commitado) e preencha antes de subir em produção.
# docker-compose.yml lê essas variáveis automaticamente de um .env na mesma pasta.

# Postgres — banco único, um schema por tenant (ver br.com.lojagenerica.multitenancy).
DB_NAME=lojagenerica
DB_USER=lojagenerica
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# "docker" sozinho já funciona (site + checkout + entrega). Acrescente
# ",oauth2" só depois de preencher OAUTH_GOOGLE_CLIENT_ID/SECRET abaixo.
SPRING_PROFILES_ACTIVE=docker

# Qualquer string longa e aleatória — nunca reaproveitar a de outro projeto
# nem entre tenants diferentes.
JWT_SECRET=

# Access token de produção do Mercado Pago (por tenant — ver docs).
MP_ACCESS_TOKEN=

# Google Cloud Console → Google Auth Platform → Clientes (1 projeto por
# marca, pra não misturar branding na tela de consentimento). Sem essas
# duas variáveis, o site funciona normalmente, só sem o botão "Entrar com
# Google".
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Token do domínio em www.duckdns.org (canto superior da página, depois de
# logar) — mantém DUCKDNS_DOMAIN apontando pro IP público atual. Sem os
# dois preenchidos, o serviço "duckdns" do compose só avisa e não faz nada
# (o site continua acessível só por IP:porta direto, sem domínio/HTTPS).
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
